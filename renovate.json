{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release binaries a workflow downloads: a version and the sha256 of its archive",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[\\w.-]+/[\\w.-]+)\\n\\s+[A-Z0-9_]+_VERSION: (?<currentValue>v\\d\\S*)\\n\\s+[A-Z0-9_]+_SHA256: (?<currentDigest>[0-9a-f]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "semanticCommitType": "ci"
    },
    {
      "matchDepTypes": ["peerDependencies", "engines"],
      "enabled": false
    },
    {
      "matchManagers": ["nodenv"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
