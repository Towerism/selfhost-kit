{
  "name": "@towerism/selfhost-kit",
  "version": "0.0.0-development",
  "description": "Shared, security-sensitive platform code for Towerism's self-hosted Nuxt 4 apps",
  "license": "MIT",
  "author": "Martin Fracker, Jr.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Towerism/selfhost-kit.git"
  },
  "homepage": "https://github.com/Towerism/selfhost-kit#readme",
  "bugs": "https://github.com/Towerism/selfhost-kit/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@10.34.7",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./nitro": {
      "types": "./dist/nitro/index.d.ts",
      "default": "./dist/nitro/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./release-config": {
      "types": "./release-config/index.d.ts",
      "default": "./release-config/index.js"
    },
    "./docker/*": "./docker/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "selfhost-kit": "./bin/selfhost-kit.mjs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin/selfhost-kit.mjs",
    "docker/entrypoint.sh",
    "docker/fetch-litestream.sh",
    "docker/litestream.yml",
    "release-config/*.js",
    "release-config/*.d.ts",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --coverage",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "test:package": "vitest run --project package",
    "bench": "vitest bench --run --project 'unit (bench)'",
    "test:entrypoint": "docker build -f test/entrypoint/Dockerfile --target fixture -t selfhost-kit-entrypoint:test . && test/entrypoint/run.sh selfhost-kit-entrypoint:test"
  },
  "peerDependencies": {
    "@semantic-release/exec": "^7",
    "conventional-changelog-conventionalcommits": "^9",
    "h3": "^1.15",
    "semantic-release": "^24 || ^25",
    "vitest": "^3.2 || ^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@semantic-release/exec": {
      "optional": true
    },
    "conventional-changelog-conventionalcommits": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "semantic-release": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "h3": "^1.15.11",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  }
}
